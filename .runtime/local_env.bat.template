@echo off
rem Copy this file to .runtime\local_env.bat to override local runtime settings.
rem Default behavior binds the API and Manager to 127.0.0.1 only.
rem Set VIDEOLINGO_LAN_MODE=1 only on a trusted LAN. This mode has no authentication or TLS.
set "VIDEOLINGO_LAN_MODE=0"

rem GPU service values are automatically configured from NVIDIA VRAM during installation. Set 0 to keep manual values.
set "GPU_SERVICE_AUTO_CONFIG=1"
rem Valid enabled values: 1, true, yes, on. Auto configuration enables only detected NVIDIA CUDA GPUs.
set "GPU_SERVICE_ENABLED=0"
rem Automatic values scale with VRAM. In manual mode this must be an integer >= 1.
set "GPU_SERVICE_MAX_LANES=1"
rem Free VRAM protection threshold in GB. In manual mode this must be >= 0.
set "GPU_SERVICE_VRAM_HEADROOM_GB=1.0"
rem Idle lane timeout and per-task timeout in seconds.
set "GPU_SERVICE_LANE_IDLE_TIMEOUT=600"
rem Shortened idle timeout (seconds) applied automatically when free VRAM < 2x headroom.
set "GPU_SERVICE_PRESSURE_IDLE_TIMEOUT=60"
set "GPU_SERVICE_JOB_TIMEOUT=3600"
