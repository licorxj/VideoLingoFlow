    {
      "id": "index_tts",
      "name": "IndexTTS-V2",
      "type": "local",
      "builtin": true,
      "enabled": true,
      "description": "【推荐值：****】B站开源的优秀的TTS，音色克隆效果好，支持5种情感控制模式（instruct/speaker/reference/vector/text）",
      "config": {
        "api_url": "http://localhost:8855",
        "text_param": "text",
        "ref_audio_param": "spk_audio_path",
        "modes": {
          "clone": {
            "enabled": true,
            "endpoint": "/api/v1/voice/clone"
          },
          "voice_design": {
            "enabled": false,
            "endpoint": ""
          },
          "controllable_clone": {
            "enabled": true,
            "endpoint": "/api/v1/voice/clone"
          },
          "preset_voice": {
            "enabled": false,
            "endpoint": ""
          }
        },
        "voice_design_param": null,
        "controllable_clone_param": "instruct",
        "speed_param": null,
        "body_type": "form",
        "is_async": true,
        "model_options": [],
        "custom_params": [
          {
            "key": "emo_control_method",
            "default": "speaker",
            "description": "情感控制方式：speaker(参考音频情感)/reference(独立情感音频)/vector(情感向量)/text(情感描述)"
          },
          {
            "key": "emo_audio_path",
            "default": "",
            "description": "情感参考音频路径（reference模式时使用）"
          },
          {
            "key": "emo_vector",
            "default": "",
            "description": "8维情感向量，逗号分隔（vector模式时使用）：happy,angry,sad,afraid,disgusted,melancholic,surprised,calm"
          },
          {
            "key": "emo_text",
            "default": "",
            "description": "情感描述文本（text模式时使用）"
          },
          {
            "key": "emo_alpha",
            "default": "1.0",
            "description": "情感权重（0.0-1.0），控制情感表达强度"
          },
          {
            "key": "use_random",
            "default": "false",
            "description": "情感随机采样（会降低音色还原度）"
          },
          {
            "key": "num_beams",
            "default": "3",
            "description": "beam search 宽度（1-10），值越大质量越好但速度越慢"
          },
          {
            "key": "temperature",
            "default": "0.8",
            "description": "采样温度（0.1-2.0），越低越稳定，越高越有变化"
          },
          {
            "key": "top_p",
            "default": "0.8",
            "description": "nucleus 采样概率阈值（0.0-1.0）"
          },
          {
            "key": "top_k",
            "default": "30",
            "description": "top-k 采样数量（0-100，0表示不限制）"
          },
          {
            "key": "repetition_penalty",
            "default": "10.0",
            "description": "重复惩罚系数（0.1-20.0）"
          },
          {
            "key": "length_penalty",
            "default": "0.0",
            "description": "长度惩罚系数（-2.0-2.0）"
          },
          {
            "key": "max_mel_tokens",
            "default": "1500",
            "description": "最大生成 Mel Token 数（50-3000），影响最大输出时长"
          },
          {
            "key": "max_text_tokens_per_segment",
            "default": "120",
            "description": "分句最大 Token 数（20-500），影响分句长度和音频质量"
          },
          {
            "key": "do_sample",
            "default": "true",
            "description": "是否进行采样"
          }
        ],
        "max_concurrent": 1,
        "timeout": 120,
        "startup_script": "Y:\\Omnivoice\\启动_index_api.bat",
        "voice_options": []
      }
    },
