    {
      "id": "qwen3_asr",
      "name": "Qwen3-ASR (Local)",
      "type": "sdk",
      "builtin": true,
      "enabled": true,
      "description": "【四星-多语言支持，准确度高】Qwen3-ASR 系列包括 Qwen3-ASR-1.7B（最优） 和 Qwen3-ASR-0.6B，支持 52 种语言和方言的语言识别与语音识别（ASR）。两者均利用大规模语音训练数据以及其基础模型 Qwen3-Omni 强大的音频理解能力。实验表明，1.7B 版本在开源 ASR 模型中达到业界领先水平，并可与最强的商业闭源 API 相媲",
      "capabilities": {
        "vad": false,
        "word_timestamps": true,
        "speaker_diarization": false
      },
