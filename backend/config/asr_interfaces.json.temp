    {
      "id": "whisperx_local",
      "name": "WhisperX (Local)",
      "type": "sdk",
      "builtin": true,
      "enabled": true,
      "description": "【四星推荐-全球语言支持-中日识别不佳】本地运行的 faster-whisper + VAD + phoneme alignment. 支持语言丰富，支持单词级别的时间戳",
