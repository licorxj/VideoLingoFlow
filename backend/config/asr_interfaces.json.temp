    {
      "id": "mimo_asr",
      "name": "MiMo ASR (Xiaomi)",
      "capabilities": {
        "vad": false,
        "word_timestamps": false,
        "speaker_diarization": false
      },
      "config": {
        "sdk_language_list_function": "",
        "model": "mimo-v2.5-asr",
        "voice_options": [
          "auto",
          "zh",
          "en"
        ],
        "max_duration": 1800,
        "sdk_module": "backend.asr.asr_mimo",
        "sdk_function": "transcribe",
        "sdk_api_key": "",
        "model_options": [
          "mimo-v2.5-asr"
        ],
        "max_concurrent": 1,
        "language": "auto",
        "sdk_package": "",
        "timeout": 600,
        "base_url": "https://api.xiaomimimo.com/v1/chat/completions",
        "api_key": "",
        "word_timestamps": false,
        "custom_params": [],
        "diarize": false
      },
      "builtin": true,
      "description": "【五星-准确度高-中英方言较优-专业术语准确度很高】在线服务，请到小米mimo获取apikey使用。【请开启备用VAD和对齐模型后在使用】-小米官方API（MiMo-V2.5-ASR） 适用于会议转写、歌词识别、方言转写、嘈杂环境录音等场景。您可通过指定语种等参数，提升识别准确率。  核心能力  覆盖多种语言与方言：支持中英双语识别及自动语种检测，原生支持粤语、吴语、闽南语、四川话等中国方言。  支持多种复杂场景：在噪声、远场拾音、多人重叠对话等复杂声学条件下保持稳定识别，支持带伴奏的歌词转写。  精准处理多种专业内容：精准识别古诗词、专业术语、人名地名等知识密集型内容，自动生成标点无需后处理。",
      "type": "sdk",
      "enabled": true
    },
