{
  "kind": "video",
  "version": 1,
  "updated_at": "2026-10-06",
  "description": "视频风格模板库：供图生视频/文生视频节点「提示词组装」弹窗选择，按镜头语言维度（景别/运镜/光线/色调/节奏）渲染提示词。",
  "sources": [
    {"id": "self", "name": "项目自研（镜头语言维度）", "license": "project", "url": ""},
    {"id": "awesome-ai-video-prompts", "name": "Awesome AI Video Prompting（镜头语言/电影风格素材来源）", "license": "MIT", "url": "https://github.com/geekjourneyx/awesome-ai-video-prompts"}
  ],
  "common_variables": [
    {"key": "subject", "label": "主体与动作", "required": true, "default": "", "placeholder": "如：@林远站在主控台前，手指快速滑动面板，眉头紧锁"},
    {"key": "shot_scale", "label": "景别", "required": false, "default": "", "placeholder": "如：中景"},
    {"key": "camera_move", "label": "运镜", "required": false, "default": "", "placeholder": "如：固定镜头 / 缓慢推近"},
    {"key": "lighting", "label": "光线氛围", "required": false, "default": "", "placeholder": "如：冷白顶光"},
    {"key": "color", "label": "色调", "required": false, "default": "", "placeholder": "如：冷调低饱和"},
    {"key": "pace", "label": "节奏/时长", "required": false, "default": "", "placeholder": "如：3 秒，节奏平稳"},
    {"key": "extra", "label": "追加细节", "required": false, "default": "", "placeholder": "如：画面稳定，无闪烁"}
  ],
  "templates": [
    {"id": "v-cinematic-realism", "name": "电影写实", "slug": "cinematic-realism", "category": "写实", "lang": "zh", "source": "self", "tags": ["正剧", "都市"], "summary": "35mm 电影质感，浅景深，克制冷调", "prompt_template": "{subject}，{shot_scale}，{camera_move}，{lighting}，{color}，{pace}，{extra}", "negative_prompt": "画面闪烁，主体变形，突兀跳切，字幕水印", "variables": [{"key": "shot_scale", "default": "中景"}, {"key": "camera_move", "default": "缓慢推近"}, {"key": "lighting", "default": "侧逆光，柔和补光"}, {"key": "color", "default": "冷调低饱和，电影级调色"}, {"key": "pace", "default": "3 秒，节奏平稳"}], "avoid": ["夸张运镜", "二次元质感"]},
    {"id": "v-anime-tv", "name": "日式番剧", "slug": "anime-tv", "category": "动漫", "lang": "zh", "source": "self", "tags": ["动漫", "热血"], "summary": "赛璐璐动画番剧质感，作画张数感强", "prompt_template": "{subject}，{shot_scale}，{camera_move}，{lighting}，{color}，{pace}，{extra}", "negative_prompt": "写实照片质感，抽搐变形，闪烁", "variables": [{"key": "shot_scale", "default": "中景"}, {"key": "camera_move", "default": "横摇"}, {"key": "lighting", "default": "明亮平光，少量高光"}, {"key": "color", "default": "明快饱和，赛璐璐平涂"}, {"key": "pace", "default": "3 秒，动作连贯"}], "avoid": ["写实材质", "重度拖影"]},
    {"id": "v-cn-3d", "name": "国漫三维", "slug": "cn-3d", "category": "动漫", "lang": "zh", "source": "self", "tags": ["玄幻", "武侠"], "summary": "三维厚涂国漫，光影细腻，动作有重量感", "prompt_template": "{subject}，{shot_scale}，{camera_move}，{lighting}，{color}，{pace}，{extra}", "negative_prompt": "低模塑料感，穿模，帧间跳变", "variables": [{"key": "shot_scale", "default": "全景转中景"}, {"key": "camera_move", "default": "环绕运镜"}, {"key": "lighting", "default": "体积光，暖侧光"}, {"key": "color", "default": "东方雅致配色，中等饱和"}, {"key": "pace", "default": "4 秒，起手蓄力后爆发"}], "avoid": ["赛璐璐平涂", "日系配色"]},
    {"id": "v-ink-wash-motion", "name": "水墨国风动态", "slug": "ink-wash-motion", "category": "国风", "lang": "zh", "source": "self", "tags": ["古风", "写意"], "summary": "水墨晕染流动，留白写意，缓慢舒展", "prompt_template": "{subject}，{shot_scale}，{camera_move}，{lighting}，{color}，{pace}，{extra}", "negative_prompt": "硬边描线，霓虹色，快速抖镜", "variables": [{"key": "shot_scale", "default": "远景"}, {"key": "camera_move", "default": "缓慢横移"}, {"key": "lighting", "default": "柔和漫射光"}, {"key": "color", "default": "墨色为主，淡彩点缀"}, {"key": "pace", "default": "5 秒，节奏舒缓"}], "avoid": ["硬边描线", "快剪"]},
    {"id": "v-cyberpunk-night", "name": "赛博朋克夜景", "slug": "cyberpunk-night", "category": "科幻", "lang": "zh", "source": "self", "tags": ["科幻", "悬疑"], "summary": "霓虹雨夜，冷暖强对比，湿滑反光", "prompt_template": "{subject}，{shot_scale}，{camera_move}，{lighting}，{color}，{pace}，{extra}", "negative_prompt": "明亮日景，田园氛围，低对比", "variables": [{"key": "shot_scale", "default": "中景"}, {"key": "camera_move", "default": "手持跟随"}, {"key": "lighting", "default": "霓虹反射，雨夜湿地面反光"}, {"key": "color", "default": "洋红与青蓝强对比"}, {"key": "pace", "default": "3 秒，节奏紧凑"}], "avoid": ["暖调", "古风"]},
    {"id": "v-doc-handheld", "name": "纪录片手持", "slug": "doc-handheld", "category": "写实", "lang": "zh", "source": "self", "tags": ["纪实", "日常"], "summary": "手持纪实，轻微晃动，自然光", "prompt_template": "{subject}，{shot_scale}，{camera_move}，{lighting}，{color}，{pace}，{extra}", "negative_prompt": "电影级稳定器平滑感，棚拍光，过曝", "variables": [{"key": "shot_scale", "default": "中近景"}, {"key": "camera_move", "default": "手持轻微晃动，跟随主体"}, {"key": "lighting", "default": "自然光，无补光"}, {"key": "color", "default": "真实还原，轻微降饱和"}, {"key": "pace", "default": "4 秒，呼吸感节奏"}], "avoid": ["过度稳定", "戏剧化打光"]},
    {"id": "v-product-macro", "name": "广告产品特写", "slug": "product-macro", "category": "广告", "lang": "zh", "source": "self", "tags": ["广告", "产品"], "summary": "微距产品展示，棚拍布光，材质高光", "prompt_template": "{subject}，{shot_scale}，{camera_move}，{lighting}，{color}，{pace}，{extra}", "negative_prompt": "手持晃动，杂乱背景，人物入镜", "variables": [{"key": "shot_scale", "default": "微距特写"}, {"key": "camera_move", "default": "缓慢环绕，焦点平移"}, {"key": "lighting", "default": "三点棚拍光，柔光箱高光"}, {"key": "color", "default": "干净通透，主体色突出"}, {"key": "pace", "default": "3 秒，匀速平滑"}], "avoid": ["手持晃动", "杂乱背景"]},
    {"id": "v-wuxia-action", "name": "武侠动作", "slug": "wuxia-action", "category": "动作", "lang": "zh", "source": "self", "tags": ["武侠", "动作"], "summary": "高速动作，速度线，腾挪与命中瞬间", "prompt_template": "{subject}，{shot_scale}，{camera_move}，{lighting}，{color}，{pace}，{extra}", "negative_prompt": "慢动作拖沓，动作模糊不清，穿模", "variables": [{"key": "shot_scale", "default": "中景转特写"}, {"key": "camera_move", "default": "快速跟摇，命中瞬间轻微顿帧"}, {"key": "lighting", "default": "逆光轮廓光，尘土扬尘感"}, {"key": "color", "default": "土黄与墨青，中等饱和"}, {"key": "pace", "default": "2-3 秒，快起快收"}], "avoid": ["慢节奏", "过度升格"]},
    {"id": "v-thriller-noir", "name": "悬疑黑色", "slug": "thriller-noir", "category": "悬疑", "lang": "zh", "source": "self", "tags": ["悬疑", "惊悚"], "summary": "低照度，强反差，阴影主导", "prompt_template": "{subject}，{shot_scale}，{camera_move}，{lighting}，{color}，{pace}，{extra}", "negative_prompt": "明亮平光，欢乐氛围，高饱和", "variables": [{"key": "shot_scale", "default": "特写"}, {"key": "camera_move", "default": "缓慢推近，轻微手持"}, {"key": "lighting", "default": "单一硬光源，大面积阴影"}, {"key": "color", "default": "低饱和冷灰，暗部压黑"}, {"key": "pace", "default": "4 秒，压抑缓慢"}], "avoid": ["明亮", "高饱和"]},
    {"id": "v-healing-daily", "name": "治愈日常", "slug": "healing-daily", "category": "日常", "lang": "zh", "source": "self", "tags": ["日常", "治愈"], "summary": "温暖自然光，柔和色调，慢生活", "prompt_template": "{subject}，{shot_scale}，{camera_move}，{lighting}，{color}，{pace}，{extra}", "negative_prompt": "冷峻工业感，强反差，快速剪辑", "variables": [{"key": "shot_scale", "default": "中景"}, {"key": "camera_move", "default": "固定镜头，轻微呼吸感"}, {"key": "lighting", "default": "午后自然光，暖调"}, {"key": "color", "default": "暖奶油色调，柔和"}, {"key": "pace", "default": "5 秒，舒缓"}], "avoid": ["冷调", "快剪"]},
    {"id": "v-epic-war", "name": "史诗战争", "slug": "epic-war", "category": "史诗", "lang": "zh", "source": "self", "tags": ["战争", "史诗"], "summary": "大场面广角，烟尘与火光，群体调度", "prompt_template": "{subject}，{shot_scale}，{camera_move}，{lighting}，{color}，{pace}，{extra}", "negative_prompt": "单人静态特写，卡通质感，画面干净无尘", "variables": [{"key": "shot_scale", "default": "大远景"}, {"key": "camera_move", "default": "航拍推进 + 低机位横移"}, {"key": "lighting", "default": "火光与烟尘逆光"}, {"key": "color", "default": "土褐与暗红，低饱和"}, {"key": "pace", "default": "5 秒，由静转动"}], "avoid": ["小景别", "卡通"]},
    {"id": "v-stop-motion", "name": "定格动画", "slug": "stop-motion", "category": "定格", "lang": "zh", "source": "self", "tags": ["定格", "童话"], "summary": "逐帧定格质感，材质手作，节奏顿挫", "prompt_template": "{subject}，{shot_scale}，{camera_move}，{lighting}，{color}，{pace}，{extra}", "negative_prompt": "丝滑连续运动，写实皮肤，重度动态模糊", "variables": [{"key": "shot_scale", "default": "中景"}, {"key": "camera_move", "default": "固定镜头，主体逐帧位移"}, {"key": "lighting", "default": "柔和棚拍光"}, {"key": "color", "default": "手作材质原色，温暖"}, {"key": "pace", "default": "3 秒，顿挫感节奏"}], "avoid": ["丝滑运动", "写实"]},
    {"id": "v-mono-film", "name": "黑白胶片", "slug": "mono-film", "category": "写实", "lang": "zh", "source": "self", "tags": ["黑白", "文艺"], "summary": "黑白胶片颗粒，高反差，文艺气质", "prompt_template": "{subject}，{shot_scale}，{camera_move}，{lighting}，{color}，{pace}，{extra}", "negative_prompt": "彩色，低反差灰调，数字感过强", "variables": [{"key": "shot_scale", "default": "中景"}, {"key": "camera_move", "default": "固定镜头"}, {"key": "lighting", "default": "硬光侧逆，明暗交界清晰"}, {"key": "color", "default": "黑白灰阶，明显胶片颗粒"}, {"key": "pace", "default": "4 秒，安静"}], "avoid": ["彩色", "低反差"]},
    {"id": "v-anime-mv-fastcut", "name": "动漫 MV 快剪", "slug": "anime-mv-fastcut", "category": "动漫", "lang": "zh", "source": "self", "tags": ["MV", "快剪"], "summary": "多机位快速切换，强节奏卡点", "prompt_template": "{subject}，{shot_scale}，{camera_move}，{lighting}，{color}，{pace}，{extra}", "negative_prompt": "长镜头静止，单一机位，节奏拖沓", "variables": [{"key": "shot_scale", "default": "特写与中景交替"}, {"key": "camera_move", "default": "快速切镜，甩镜转场"}, {"key": "lighting", "default": "舞台感追光，高光闪烁"}, {"key": "color", "default": "高饱和撞色"}, {"key": "pace", "default": "2 秒一镜，卡点节奏"}], "avoid": ["长镜头", "低饱和"]},
    {"id": "v-drone-aerial", "name": "无人机航拍", "slug": "drone-aerial", "category": "风光", "lang": "zh", "source": "self", "tags": ["航拍", "风光"], "summary": "高空俯瞰，缓慢推进，宏大空间", "prompt_template": "{subject}，{shot_scale}，{camera_move}，{lighting}，{color}，{pace}，{extra}", "negative_prompt": "人物特写，室内场景，剧烈抖动", "variables": [{"key": "shot_scale", "default": "大远景俯瞰"}, {"key": "camera_move", "default": "缓慢推进后拉升"}, {"key": "lighting", "default": "自然日光，长阴影"}, {"key": "color", "default": "通透自然色，轻微提亮"}, {"key": "pace", "default": "5 秒，匀速平滑"}], "avoid": ["人物特写", "室内"]},
    {"id": "v-found-footage", "name": "伪纪录监控", "slug": "found-footage", "category": "写实", "lang": "zh", "source": "self", "tags": ["伪纪录", "惊悚"], "summary": "监控/手持录像质感，低画质，时间码感", "prompt_template": "{subject}，{shot_scale}，{camera_move}，{lighting}，{color}，{pace}，{extra}", "negative_prompt": "电影级画质，柔光美化，稳定画面", "variables": [{"key": "shot_scale", "default": "广角固定机位"}, {"key": "camera_move", "default": "机位固定，主体入画出画"}, {"key": "lighting", "default": "顶灯与环境光，噪点明显"}, {"key": "color", "default": "低饱和偏冷，压缩噪点"}, {"key": "pace", "default": "4 秒，无剪辑"}], "avoid": ["电影级调色", "柔光"]}
  ]
}
