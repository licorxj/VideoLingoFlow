              },
              "emotions": [
                {
                  "name": "兴奋",
                  "audio_path": "voices/7e862128865a498c9c9dfca0e54ea984/emotions/兴奋.wav",
                  "text": "哇！AI技术又突破了，未来太令人兴奋了！",
                  "engine": "8dc074bb",
                  "instruct": "兴奋地，语速快，音调高，[excitedly]"
