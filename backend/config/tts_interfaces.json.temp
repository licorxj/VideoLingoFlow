{
  "version": 1,
  "interfaces": [
    {
      "id": "edge_tts",
      "name": "Edge TTS",
      "type": "sdk",
      "builtin": true,
      "enabled": true,
      "description": "【推荐值：*】在线-微软免费 TTS，支持多语言预置音色，无需 GPU",
      "config": {
        "sdk_package": "edge-tts",
        "sdk_function": "Communicate",
        "sdk_module": "edge_tts",
        "sdk_voice_list_module": "backend.tts.sdk.edge_tts_wrapper",
        "sdk_voice_list_function": "list_voices",
        "text_param": "text",
        "ref_audio_param": null,
        "speed_param": "null",
        "voice": "zh-CN-YunjianNeural",
        "model": "",
        "modes": {
          "clone": {
            "enabled": false,
            "endpoint": ""
          },
          "voice_design": {
            "enabled": false,
            "endpoint": ""
          },
          "controllable_clone": {
            "enabled": false,
            "endpoint": ""
          },
          "preset_voice": {
            "enabled": true,
            "endpoint": ""
          }
        },
        "model_list_url": "",
        "voice_list_url": "",
        "model_list_key": "",
        "voice_list_key": "",
        "model_options": [],
        "sdk_extra_args": {},
        "custom_params": [],
        "max_concurrent": 1,
        "timeout": 300,
        "voice_options": []
      }
    },
    {
      "id": "mossTTS",
      "name": "mossTTS",
      "type": "sdk",
      "builtin": true,
      "enabled": true,
      "description": "【推荐值***】内置的 轻量级MOSS-TTS-Nano ONNX CPU 语音合成，支持内置音色和参考音频克隆，应对一般要求不高的配音任务",
      "config": {
        "sdk_package": "",
        "sdk_function": "synthesize",
        "sdk_module": "backend.tts.sdk.moss_tts_wrapper",
        "sdk_voice_list_function": "list_voices",
        "text_param": "text",
        "ref_audio_param": "ref_audio",
        "speed_param": null,
        "voice": "Junhao",
        "model": "MOSS-TTS-Nano-100M-ONNX",
        "modes": {
          "clone": {
            "enabled": true,
            "endpoint": ""
          },
          "voice_design": {
            "enabled": false,
            "endpoint": ""
          },
          "controllable_clone": {
            "enabled": true,
            "endpoint": ""
          },
          "preset_voice": {
            "enabled": true,
            "endpoint": ""
          }
        },
        "model_list_url": "",
        "voice_list_url": "",
        "model_list_key": "",
        "voice_list_key": "",
        "model_options": [
          "MOSS-TTS-Nano-100M-ONNX"
        ],
        "sdk_extra_args": {
          "cpu_threads": 4,
          "max_new_frames": 375,
          "voice_clone_max_text_tokens": 75,
          "enable_wetext": false,
          "enable_normalize_tts_text": true
        },
        "custom_params": [],
        "max_concurrent": 1,
        "timeout": 600,
        "voice_options": [
          "Junhao"
        ]
      }
    },
