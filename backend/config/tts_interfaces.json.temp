    {
      "id": "omnivoice",
      "name": "OmniVoice",
      "type": "local",
      "builtin": false,
      "enabled": true,
      "description": "【推荐值：***】小米开源 TTS，支持声音克隆和声音设计、600+语音支持，多方言支持，优点：极快。缺点：不太稳定",
      "config": {
        "api_url": "http://localhost:8853",
        "text_param": "text",
        "ref_audio_param": "ref_audio_path",
        "speed_param": "speed",
        "modes": {
          "clone": {
            "enabled": true,
            "endpoint": "/api/v1/voice/clone"
          },
          "voice_design": {
            "enabled": true,
            "endpoint": "/api/v1/voice/design"
          },
          "controllable_clone": {
            "enabled": true,
            "endpoint": "/api/v1/voice/clone"
          },
          "preset_voice": {
            "enabled": false,
            "endpoint": ""
          }
        },
        "voice_design_param": "instruct",
        "controllable_clone_param": "instruct",
        "model_options": [],
        "max_concurrent": 1,
        "timeout": 300,
        "custom_params": [
          {
            "key": "ref_text",
            "default": "",
            "description": "参考音频的文本内容（不提供则自动识别）"
          },
          {
            "key": "language",
            "default": "",
            "description": "语言代码或名称（如 zh, en, ja, ko）"
          },
          {
            "key": "num_steps",
            "default": "32",
            "description": "扩散步数（1-100），默认32，越高音质越好"
          },
          {
            "key": "guidance_scale",
            "default": "2.5",
            "description": "分类器自由引导尺度（0.0-5.0）"
          },
          {
            "key": "speed",
            "default": "1.0",
            "description": "语速因子（0.5-2.0），默认1.0"
          },
          {
            "key": "duration",
            "default": "",
            "description": "固定输出时长（秒），留空则自动决定"
          },
          {
            "key": "denoise",
            "default": "false",
            "description": "是否对参考音频去噪"
          },
          {
            "key": "max_workers",
            "default": "2",
            "description": "处理线程数，默认1"
          }
        ],
        "body_type": "form",
        "is_async": true,
        "startup_script": "Y:\\Omnivoice\\启动_omnivoice_api.bat",
        "voice_options": []
      }
    },
    {
      "id": "voxcpm",
      "name": "VoxCPM",
