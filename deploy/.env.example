COMPOSE_PROJECT_NAME=videolingo
API_IMAGE=videolingo-api:local
FRONTEND_IMAGE=videolingo-frontend:local
API_PORT=11001
HTTPS_PORT=443

POSTGRES_DB=videolingo
POSTGRES_USER=videolingo
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_PORT=5432

REDIS_PASSWORD=replace-with-a-long-random-password
REDIS_PORT=6379
VOICEFORGE_REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/2
VOICEFORGE_CELERY_RESULT_URL=redis://:${REDIS_PASSWORD}@redis:6379/3

MINIO_ROOT_USER=videolingo-minio
MINIO_ROOT_PASSWORD=replace-with-a-long-random-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=videolingo-assets

TLS_CERT_FILE=./tls/fullchain.pem
TLS_KEY_FILE=./tls/privkey.pem
