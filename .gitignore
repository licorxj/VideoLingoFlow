# thirdparty：源码与 Windows 构建产物需上传；仅忽略重型/可再生内容
#   - cloakbrowser: 运行时下载（install_thirdparty.py 负责）
#   - bun: 运行时下载（install_thirdparty.py 负责）
#   - node_modules / .next / .turbo: 依赖与构建缓存
thirdparty/cloakbrowser/
thirdparty/bun/
thirdparty/**/node_modules/
thirdparty/**/.next/
thirdparty/**/.turbo/
thirdparty/**/.cache/
# 已提交的 Windows 构建产物（dist）重新纳入 git
!thirdparty/social-auto-upload-web-ui/frontend/dist/
!thirdparty/QM-LocalRouter/frontend/dist/
!thirdparty/pi/packages/*/dist/
# 子项目 git 元数据归档（安装/更新时释放为各子项目 .git），随仓库分发
!thirdparty/.git-archives/
